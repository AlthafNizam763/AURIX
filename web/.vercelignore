# Nothing here is needed to build or run the deployment.
#
# Vercel already skips node_modules and respects .gitignore; this file covers
# what is committed but has no business in a serverless bundle.

# Test and verification scripts. They talk to the database directly and create
# throwaway accounts — code that should never be deployable.
test/
scripts/smoke.mts
scripts/smoke-portal.mts
vitest.config.mts

# The frozen Express server, one directory up. Listed defensively in case the
# Root Directory is ever misconfigured to the repository root: deploying it
# would put a second copy of every secret-reading module in the bundle.
../server
../server-backup

# The Flutter application.
../mobile
