rules_version = '2';

// AURIX Firestore security rules.
//
// ## The whole model in two sentences
//
// Everything a user *owns* lives under /users/{uid}, and only the account whose
// uid that is may read or write it. Two collections are deliberately *shared* —
// /catalog/songs and /playlists — and those are readable by any signed-in
// account, writable in one exact shape, and owned by nobody.
//
// The first half is the schema's central design decision. Nesting everything a
// user owns under their own document means the authorisation rule is one line,
// it is the same line for every collection, and it automatically covers
// collections added later.
//
// The second half is what makes AURIX's imports worth anything to anyone but
// the importer. A playlist imported from Spotify is not private data — it is a
// contribution to a catalogue every listener searches — so it does not live
// under the importer's uid, and the account that imported it is recorded in a
// *field* rather than expressed by the *path*. The two blocks are the whole
// difference between "my playlists" and "AURIX's playlists", and every rule
// below belongs to one or the other.
//
// The trade that comes with a shared collection is stated plainly rather than
// hidden: a rule can enforce the *shape* of a document but not the *truth* of
// it. See the /playlists block.
//
// ## Deploying — read this before debugging a permission error
//
//   firebase deploy --only firestore:rules,firestore:indexes
//
// This file is inert until that command runs. It is a local description of the
// rules; the database enforces whatever was last pushed to the project, which
// on a new project is the locked-mode default that refuses every client read
// and write from every account, signed in or not.
//
// That is not a hypothetical failure mode — it is the one that produced
//
//   [cloud_firestore/permission-denied] Missing or insufficient permissions
//
// on `FirestorePlaylistService.findBySource` during a playlist import, from a
// correctly signed-in user against a path these rules explicitly allow. The
// repository had no `firebase.json`, so the deploy command had nothing to read
// and had never been runnable. If a permission error appears again, check that
// the rules on the project match this file *before* looking for a bug in the
// rules themselves.
//
// ## Testing
//
//   firebase emulators:start --only firestore --project demo-aurix
//   bash tool/verify_rules.sh
//
// Rules are not exercised by the Flutter test suite: they run on Google's
// servers, not in the app, so the only honest test of them is against the
// emulator. Do not treat a passing `flutter test` as evidence these are right.
// `firebase deploy` does compile them, so a syntax error is caught there.
//
// `tool/verify_rules.sh` is that emulator test. It drives the REST API with a
// separate signed-in identity per user and asserts the status code of every
// operation the shared catalogue depends on — cross-user reads allowed,
// unauthenticated reads refused, cross-user personal reads refused, provenance
// immutable, deletes restricted to the importer.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers --------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // The authorisation predicate for everything under /users/{uid}.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The keys an update actually changes.
    function changed() {
      return incoming().diff(resource.data).affectedKeys();
    }

    function incoming() {
      return request.resource.data;
    }

    // Fields a client must never set or change, on any document.
    //
    // `uid` is checked because a document that claims a different owner than
    // its path would be a confusing lie even though the path is what the rules
    // actually enforce.
    function ownsClaimedUid(uid) {
      return !('uid' in incoming()) || incoming().uid == uid;
    }

    // A string field is present and within a sane length.
    //
    // Length limits are not cosmetic here. Without them any signed-in user can
    // write a 1 MiB string into their own document as often as they like, which
    // is a storage-cost attack on the project owner rather than on any other
    // user. These bounds are generous for real content and ruinous for that.
    function isBoundedString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function hasBoundedName() {
      return !('name' in incoming()) || isBoundedString(incoming().name, 200);
    }

    // ---- The shared song catalogue --------------------------------------
    //
    // /catalog/{partition}/songs/{songId}   — in practice /catalog/global/songs
    //
    // The four-segment path is not decoration. Firestore alternates
    // collection → document → collection → document, so the shorter
    // `/catalog/songs/{songId}` names a *collection* rather than a document
    // and cannot carry an `allow` rule at all. `global` is a fixed partition
    // document that exists only to make the path legal — see FirestorePaths.
    //
    // The one collection in this database that nobody owns. It exists so that
    // a song imported by any user is findable in global search rather than
    // only inside the playlist it arrived in, and so the same song is stored
    // once rather than once per user who imports it.
    //
    // Being shared, it cannot use the one-line ownership rule that secures
    // everything else here — there is no uid in the path to compare against.
    // So it gets the strictest *shape* rule in the file instead. The threat
    // being defended against is a signed-in client writing arbitrary documents
    // into a collection every other user reads: catalogue poisoning, storage
    // inflation, and injected URLs.
    //
    // Four properties do that work:
    //
    //   1. Creates must carry exactly the fields Song.toFirestore() produces,
    //      each of the right type and within a bounded length. A document with
    //      an unexpected key is rejected outright — `hasOnly` is what makes
    //      that true, and it is why adding a field to the Song model is a
    //      rules change as well as a code change.
    //   2. Updates may touch only the narrow set of fields a re-import
    //      legitimately improves. `id`, `title`, `source` and `createdAt` are
    //      immutable after creation, so no client can repoint an existing
    //      catalogue entry at different content.
    //   3. Deletes are refused to every client, always. Removing a catalogue
    //      song would break it for every user who has it in a playlist, and
    //      there is no user action that should do that.
    //   4. Reads require a signed-in account. The catalogue is not public.
    //
    // What these rules can and cannot enforce, stated plainly: they enforce
    // *shape*, not *truth*. A client can still write a well-formed document
    // whose artwork URL does not belong to its title. Preventing that needs
    // the write to happen somewhere the client cannot reach — a Cloud Function
    // — and the swap is documented at CatalogRepository. This block is the
    // right boundary for a client-only app, and it is deliberately the only
    // place in this file where a client writes something another user reads.

    match /catalog/{partition}/songs/{songId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && incoming().keys().hasOnly([
             'id', 'title', 'artists', 'album', 'duration', 'artworkUrl',
             'source', 'sourceId', 'externalUrl', 'explicit', 'searchTokens',
             'spotifyId', 'youtubeVideoId', 'previewUrl',
             'createdAt', 'updatedAt'
           ])
        // The document must know its own id. Without this a client could
        // write a song whose `id` field addresses a different document, which
        // every reader would then trust.
        && incoming().id == songId
        && isBoundedString(incoming().title, 500)
        && isBoundedString(incoming().album, 500)
        && isBoundedString(incoming().source, 20)
        && isBoundedString(incoming().sourceId, 200)
        // Every URL field is length-capped so it cannot become a data: URI.
        // AURIX has no image-upload path and no audio-upload path, and this is
        // where that stays true against a hand-crafted write.
        && isBoundedString(incoming().artworkUrl, 2000)
        && isBoundedString(incoming().externalUrl, 2000)
        && incoming().duration is int
        && incoming().duration >= 0
        && incoming().explicit is bool
        // The artist list and the token array are the two places an attacker
        // could inflate a document without tripping a string-length check, so
        // both are capped by size as well as by element type.
        && incoming().artists is list
        && incoming().artists.size() <= 20
        && incoming().searchTokens is list
        && incoming().searchTokens.size() <= 200
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // A re-import may improve a row. It may not rewrite what the row *is*.
      allow update: if isSignedIn()
        && incoming().diff(resource.data).affectedKeys().hasOnly([
             'album', 'duration', 'artworkUrl', 'externalUrl',
             'spotifyId', 'youtubeVideoId', 'previewUrl',
             'searchTokens', 'updatedAt'
           ])
        && isBoundedString(incoming().album, 500)
        && isBoundedString(incoming().artworkUrl, 2000)
        && isBoundedString(incoming().externalUrl, 2000)
        && incoming().duration is int
        && incoming().duration >= 0
        && incoming().searchTokens is list
        && incoming().searchTokens.size() <= 200
        && incoming().updatedAt == request.time;

      // Never. See point 3 above.
      allow delete: if false;
    }

    // Anything else under /catalog: a second catalogue collection added later
    // gets no access until it gets its own rule.
    //
    // Worth being precise about what this does, because the obvious reading is
    // wrong: `allow` rules are additive and there is no `deny`, so this block
    // cannot revoke anything the block above grants. A path matched by both is
    // allowed. What it does is state the default for paths matched by *only*
    // this one — which is already the default, so its real value is that a
    // reader of this file can see the boundary was considered rather than
    // forgotten.
    match /catalog/{document=**} {
      allow read, write: if false;
    }

    // ---- The shared playlist catalogue ----------------------------------
    //
    // /playlists/{playlistId}
    // /playlists/{playlistId}/tracks/{trackId}
    //
    // The collection that makes an import worth something to somebody other
    // than the importer. User A imports "Love"; User B and User C can search
    // it, open it and play it. That is the requirement, and a top-level
    // collection is the only shape that expresses it — a document under
    // /users/{uid} cannot be read by another account without a rule that is
    // indistinguishable from a leak.
    //
    // ## Provenance is recorded, not enforcing
    //
    // `importedByUserId`, `importedBy` and `importedAt` say who brought the
    // playlist in. **None of them narrows who may read it.** The read rule
    // below is `isSignedIn()` and nothing more, and there is deliberately no
    // owner clause anywhere on the read path — adding one would put the
    // architecture back where it started, where a playlist was visible only to
    // the account that imported it.
    //
    // `importedByUserId` gates exactly one thing: deletion. Removing a shared
    // playlist removes it for every user who has ever found it, so it is
    // permitted to the importer alone.
    //
    // ## The threat model, and what these rules do about it
    //
    // Every signed-in client can write here, and every signed-in client reads
    // what they wrote. That is the same exposure as /catalog/songs and it is
    // defended the same way — by shape, and by there being exactly one code
    // path in the app that reaches the collection
    // (`PlaylistCatalogRepository`):
    //
    //   1. A create must carry exactly the fields the service writes, each of
    //      the right type and bounded. `hasOnly` is what makes that true, and
    //      it is why adding a field to a shared playlist is a rules change as
    //      well as a code change.
    //   2. A create must claim its own author: `importedByUserId` has to equal
    //      `request.auth.uid`. Nobody can publish a playlist under somebody
    //      else's name, or hand themselves somebody else's delete right.
    //   3. An update may touch only what a re-sync legitimately improves. The
    //      playlist's identity (`source`, `sourceId`), its provenance and its
    //      `createdAt` are immutable after creation, so no client can repoint
    //      an existing catalogue entry at different content or take it over.
    //   4. Renaming, re-covering and re-describing are the importer's alone.
    //      Any signed-in account may *refresh* an entry — bump `trackCount`,
    //      `syncedAt`, `updatedAt` — because that is how the catalogue stays
    //      current, but a passer-by cannot retitle a playlist thousands of
    //      users may see.
    //   5. Deletes: importer only. Track deletes too, checked against the
    //      parent document.
    //   6. Reads require a signed-in account. The catalogue is shared, not
    //      public.
    //
    // What this cannot do, stated plainly: it enforces *shape*, not *truth*. A
    // client can still write a well-formed playlist whose cover art does not
    // belong to its title, or whose title is chosen to rank against a popular
    // query. Preventing that needs the write to happen where the client cannot
    // reach — a Cloud Function — and the swap is documented at
    // PlaylistCatalogRepository. This is the right boundary for a client-only
    // app and it is deliberately narrow.

    match /playlists/{playlistId} {
      // Shared. No owner clause, by design — see above.
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && incoming().keys().hasOnly([
             'name', 'description', 'coverUrl',
             'source', 'sourceId', 'sourceUrl',
             'searchTitle', 'searchTokens', 'trackCount',
             'importedByUserId', 'importedBy', 'importedAt',
             'createdAt', 'updatedAt'
           ])
        // Point 2: the document must claim the account writing it.
        && incoming().importedByUserId == request.auth.uid
        && isBoundedString(incoming().name, 200)
        && incoming().name.size() > 0
        && isBoundedString(incoming().description, 2000)
        && isBoundedString(incoming().importedBy, 200)
        // Only imported playlists belong here. A playlist made in AURIX is
        // private and lives under /users/{uid} — writing one to the shared
        // catalogue would be a bug, and this is where it fails.
        && incoming().source in ['spotify', 'youtube']
        && isBoundedString(incoming().sourceId, 200)
        && incoming().sourceId.size() > 0
        // Cover art is a URL to somewhere else — the source's CDN, or
        // nothing. Never image data: a data: URI here would be an upload path
        // through the back door, into a collection every user reads.
        && isBoundedString(incoming().coverUrl, 2000)
        && isBoundedString(incoming().sourceUrl, 2000)
        && isBoundedString(incoming().searchTitle, 500)
        // The token array is the one field an attacker could inflate without
        // tripping a string-length check, so it is capped by size as well.
        && incoming().searchTokens is list
        && incoming().searchTokens.size() <= 200
        && incoming().trackCount is int
        && incoming().trackCount >= 0
        // Server time, not client time. A shared collection cannot be ordered
        // by a client clock, and one device with a wrong date would otherwise
        // reorder the catalogue for everybody.
        && incoming().importedAt == request.time
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // Point 3: identity and provenance are immutable, for everybody.
      //
      // Written as "unchanged if present" rather than "absent from the diff"
      // so that a merge write which re-sends an identical value is allowed,
      // while any write that would *alter* one is refused.
      allow update: if isSignedIn()
        && incoming().source == resource.data.source
        && incoming().sourceId == resource.data.sourceId
        && incoming().importedByUserId == resource.data.importedByUserId
        && incoming().importedAt == resource.data.importedAt
        && incoming().createdAt == resource.data.createdAt
        && incoming().updatedAt == request.time
        && incoming().trackCount is int
        && incoming().trackCount >= 0
        && isBoundedString(incoming().name, 200)
        && isBoundedString(incoming().coverUrl, 2000)
        && isBoundedString(incoming().searchTitle, 500)
        && incoming().searchTokens is list
        && incoming().searchTokens.size() <= 200
        && (
             // Point 4. The importer may change how the playlist presents
             // itself; everybody else may only record that they refreshed it.
             request.auth.uid == resource.data.importedByUserId
               ? changed().hasOnly([
                   'name', 'description', 'coverUrl', 'sourceUrl',
                   'searchTitle', 'searchTokens', 'trackCount',
                   'syncedAt', 'updatedAt'
                 ])
               : changed().hasOnly(['trackCount', 'syncedAt', 'updatedAt'])
           );

      // Point 5. Deleting a shared playlist deletes it for every user who has
      // found it, so it belongs to the account that contributed it.
      allow delete: if isSignedIn()
        && resource.data.importedByUserId == request.auth.uid;

      // ---- Tracks in a shared playlist ---------------------------------
      //
      // One copy of the track list, read by everyone who opens the playlist —
      // not one copy per user. Any signed-in account may write a row, which is
      // what lets a sync run by a listener who is not the importer still pull
      // in songs the source has added.
      //
      // Deletion is the asymmetric case and is treated as such: a removed row
      // is removed for everybody, so it takes a `get()` on the parent to check
      // the requester is the importer. That read is billed per delete, which is
      // the price of not letting any account empty anybody's playlist.
      // `PlaylistImportService` checks the same condition client-side first, so
      // in practice this rule refuses only a hand-crafted request.

      match /tracks/{trackId} {
        allow read: if isSignedIn();

        allow create, update: if isSignedIn()
          && isBoundedString(incoming().title, 500)
          && isBoundedString(incoming().artist, 500)
          && (!('album' in incoming())
              || isBoundedString(incoming().album, 500))
          && (!('artworkUrl' in incoming())
              || isBoundedString(incoming().artworkUrl, 2000))
          && (!('previewUrl' in incoming())
              || isBoundedString(incoming().previewUrl, 2000))
          && (!('durationMs' in incoming()) || incoming().durationMs is int)
          // The sort key. A double, not an int — see the fractional-position
          // scheme in FirestorePlaylistService.
          && (!('position' in incoming()) || incoming().position is number);

        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/playlists/$(playlistId))
               .data.importedByUserId == request.auth.uid;
      }
    }

    // ---- The user document ----------------------------------------------
    //
    // /users/{uid} — profile: uid, name, email, avatarId, createdAt, updatedAt.

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && ownsClaimedUid(uid)
        && hasBoundedName()
        // An avatar id names a bundled asset. Bounded so it cannot become a
        // URL or a base64 blob — AURIX has no image-upload path, and this is
        // where that stays true against a hand-crafted write.
        && (!('avatarId' in incoming()) || isBoundedString(incoming().avatarId, 40))
        && isBoundedString(incoming().email, 320);

      allow update: if isOwner(uid)
        && ownsClaimedUid(uid)
        && hasBoundedName()
        && (!('avatarId' in incoming()) || isBoundedString(incoming().avatarId, 40))
        // `createdAt` is written once, by the client that creates the
        // document, and must not move afterwards: it orders "member since" and
        // is the tie-break if two devices ever race a create.
        && (!('createdAt' in incoming())
            || incoming().createdAt == resource.data.createdAt);

      // Deleting the profile while its subcollections still exist would orphan
      // every playlist and liked song under it — invisible to the owner,
      // permanently billed, and unreachable by any client query. Account
      // deletion belongs in a Cloud Function that walks the subcollections
      // first.
      allow delete: if false;

      // ---- Playlists ----------------------------------------------------

      match /playlists/{playlistId} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && isBoundedString(incoming().name, 200)
          && (!('description' in incoming())
              || isBoundedString(incoming().description, 2000))
          // Cover art is a URL to somewhere else — the source's CDN, or
          // nothing. Never image data: a data: URI here would be an upload
          // path through the back door.
          && (!('coverUrl' in incoming())
              || isBoundedString(incoming().coverUrl, 2000));

        allow delete: if isOwner(uid);

        // ---- Tracks in a playlist ---------------------------------------

        match /tracks/{trackId} {
          allow read: if isOwner(uid);

          allow create, update: if isOwner(uid)
            && isBoundedString(incoming().title, 500)
            && isBoundedString(incoming().artist, 500)
            && (!('artworkUrl' in incoming())
                || isBoundedString(incoming().artworkUrl, 2000))
            // The sort key. A double, not an int — see the fractional-position
            // scheme in FirestorePlaylistService.
            && (!('position' in incoming()) || incoming().position is number);

          allow delete: if isOwner(uid);
        }
      }

      // ---- Liked songs ----------------------------------------------------

      match /likedTracks/{trackId} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && isBoundedString(incoming().title, 500)
          && isBoundedString(incoming().artist, 500)
          && (!('artworkUrl' in incoming())
              || isBoundedString(incoming().artworkUrl, 2000));

        allow delete: if isOwner(uid);
      }

      // ---- Play history ---------------------------------------------------

      match /recentlyPlayed/{itemId} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && isBoundedString(incoming().title, 500)
          && isBoundedString(incoming().artist, 500);

        // Split out from the single `allow write` this used to be, which was a
        // real bug rather than a tidy-up.
        //
        // `write` covers delete as well as create and update, and on a delete
        // `request.resource` is null — so both `incoming()` checks above were
        // evaluating against nothing, the rule errored, and *every* deletion
        // from this collection was refused. Two things do delete from it:
        // `FirestoreLibraryService._trimHistory`, which caps the collection at
        // 200 entries, and `clearHistory`. Both wrap their writes in a catch
        // that logs at debug level, so the failure was invisible while the
        // history grew without bound.
        //
        // There is nothing to validate on a delete: the row is going away.
        allow delete: if isOwner(uid);
      }

      // ---- Per-account settings -------------------------------------------
      //
      // Nothing writes here yet. The path is declared so that the first thing
      // that does is already covered rather than falling through to the
      // catch-all below and being denied in production.

      match /settings/{settingId} {
        allow read, write: if isOwner(uid);
      }

      // Any subcollection added under /users/{uid} in future and not matched
      // above. It gets no access until it gets its own rule — a new collection
      // should fail loudly in development rather than inherit access silently.
      //
      // The same caveat as the /catalog catch-all applies: this does not
      // subtract from the blocks above it. `allow` rules are unioned, so a
      // playlist document matched both by `/playlists/{playlistId}` and by this
      // wildcard is allowed on the strength of the first. This states the
      // default for everything else.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ---- Everything else ------------------------------------------------
    //
    // The two shared collections above are the only ones AURIX has, and both
    // are matched by their own blocks. This is the default for everything else:
    // it is what stops a mistyped path elsewhere in the app from writing to an
    // unprotected part of the database.
    //
    // ## Why /playlists is not filtered by an owner, unlike everything else
    //
    // Worth recording, because the obvious rule for a top-level collection is
    // the wrong one here. The conventional shape is:
    //
    //   match /playlists/{playlistId} {
    //     allow read: if isSignedIn()
    //       && resource.data.ownerUid == request.auth.uid;
    //   }
    //
    // …which makes a playlist visible only to whoever wrote it. That is exactly
    // the behaviour the shared catalogue exists to remove, and it has a second
    // cost worth knowing about: a query whose rule reads `resource.data` is
    // rejected wholesale unless the query itself carries the matching
    // `where()` clause, so every call site has to remember a filter or fail.
    //
    // The catalogue avoids both by not being owned at all. The read rule is
    // `isSignedIn()`, no query needs a filter to be allowed, and the account
    // that imported a playlist is a field the *write* rules consult rather than
    // a condition the *read* rules impose. Private data is not defended by an
    // ownerUid check on a shared collection — it is defended by living under
    // /users/{uid}, where it still is. See FirestorePaths.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
