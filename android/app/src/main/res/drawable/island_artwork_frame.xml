<?xml version="1.0" encoding="utf-8"?>
<!-- Rounds the cover. The ImageView sets clipToOutline, which is what makes
     this shape clip the bitmap rather than merely sit behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/island_artwork_empty" />
    <corners android:radius="12dp" />
</shape>
