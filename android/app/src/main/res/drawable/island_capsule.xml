<?xml version="1.0" encoding="utf-8"?>
<!--
    The capsule.

    A 26dp radius on a ~62dp collapsed box reads as a pill without being a
    stadium: fully rounding the ends would leave no straight edge for the
    artwork to sit against, and the expanded box — three times as tall — would
    inherit ends round enough to clip the transport row.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/island_surface" />
    <corners android:radius="26dp" />
    <stroke
        android:width="1dp"
        android:color="@color/island_border" />
</shape>
