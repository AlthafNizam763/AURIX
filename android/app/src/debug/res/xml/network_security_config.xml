<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG BUILDS ONLY. This file lives in src/debug and is merged only into
    debug variants; release builds keep Android's default policy, which
    forbids cleartext HTTP everywhere.

    Why it exists:

    Android 9 (API 28) and newer block cleartext HTTP by default. A local
    development backend served over plain http:// is therefore unreachable
    from a device or emulator, and the failure looks like a connection error
    rather than a policy decision, which is easy to mistake for the backend
    being down.

    AURIX itself does not need this. The Spotify Web API and accounts
    endpoints are HTTPS, and PKCE requires no backend at all. It matters only
    when AUTH_PROXY_BASE_URL_MOBILE points at a local http:// address.

    What is permitted:

    Only the addresses that mean "the development machine". Everything else,
    including in debug, still requires HTTPS.

      192.168.0.6   this project's development PC on the LAN. CHANGE THIS to
                    your own IPv4 address if you work on a different machine
                    (ipconfig on Windows, ip addr elsewhere).
      10.0.2.2      the host machine as seen from the Android emulator.
      10.0.3.2      the same, for Genymotion.
      127.0.0.1     loopback, for "adb reverse tcp:PORT tcp:PORT" setups.
      localhost     the same by name.

    If you would rather not maintain a list, "adb reverse tcp:PORT tcp:PORT"
    forwards the device's own loopback to the host and needs no LAN address at
    all. 127.0.0.1 is already covered below.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.6</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
