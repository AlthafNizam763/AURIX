<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug-only cleartext policy.

         Merged into debug variants only, so release builds keep Android's
         default (HTTPS everywhere). It permits plain http:// to the
         development machine and nothing else — see
         src/debug/res/xml/network_security_config.xml for the address list
         and the reasoning.

         Inert unless AUTH_PROXY_BASE_URL_MOBILE is pointed at a local http://
         backend: AURIX talks to Spotify over HTTPS and needs no backend of
         its own. -->
    <application android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
