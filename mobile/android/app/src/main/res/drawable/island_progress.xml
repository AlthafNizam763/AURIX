<?xml version="1.0" encoding="utf-8"?>
<!-- The 2dp hairline under the title row. Same two-tone treatment as the mini
     player's: a dim track, the accent for elapsed. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/island_track" />
            <corners android:radius="1dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/island_accent" />
                <corners android:radius="1dp" />
            </shape>
        </clip>
    </item>
</layer-list>
