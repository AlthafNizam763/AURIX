# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/mobile/build/
/mobile/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/mobile/android/app/debug
/mobile/android/app/profile
/mobile/android/app/release

# ---------------------------------------------------------------------------
# Secrets / local configuration — never commit these.
# `.env.example` IS committed and is the template for `.env`.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Signing material
*.jks
*.keystore
/mobile/android/key.properties
**/ios/Runner/GoogleService-Info.plist
**/android/app/google-services.json

# Generated by the Flutter tool on every build. A stale checked-in copy breaks
# release builds: it registers plugins from dev_dependencies (integration_test)
# which are absent from a release dependency graph, so javac fails with
# "package dev.flutter.plugins.integration_test does not exist".
**/android/**/GeneratedPluginRegistrant.java
**/ios/Runner/GeneratedPluginRegistrant.*

# Local tooling output
/mobile/tool/out/

# Firebase emulator artefacts. Written into the repo root by
# `firebase emulators:start`; none of it is source.
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/

# The development OTP sink (OTP_DEV_DELIVERY=file).
#
# Holds plaintext one-time codes. Never committed, never deployed — and the
# server refuses to write it at all under NODE_ENV=production.
server/otp-dev.log
server-backup/otp-dev.log

# ---------------------------------------------------------------------------
# The frozen reference copy of the Express server (Phase 3 of the Next.js
# migration). `server/` itself is still tracked and still runnable; this is a
# local safety net for the migration only, and git history already holds the
# same content, so committing a second copy of 7,600 lines buys nothing.
# Delete it once Phase 15 signs off.
# ---------------------------------------------------------------------------
/server-backup/

# ---------------------------------------------------------------------------
# Next.js — web/
# ---------------------------------------------------------------------------
/web/node_modules/
/web/.next/
/web/out/
/web/build/
/web/.vercel/
/web/next-env.d.ts
/web/*.tsbuildinfo
