# ---------------------------------------------------------------------------
# AURIX API — server configuration
#
# Copy to `server/.env` and fill in. This file is committed; `.env` is not, and
# must never be. Nothing here is ever sent to a client: the Flutter app knows
# only the base URL of this server, and reaches MongoDB exclusively through it.
#
#   cp server/.env.example server/.env
#   cd server && npm install && npm start
# ---------------------------------------------------------------------------

# ---- MongoDB (required) ---------------------------------------------------
# The Atlas connection string. Replace <USERNAME> and <PASSWORD> with the
# database user's credentials from Atlas → Database Access.
#
# PUT THE REAL VALUE IN `server/.env`, NOT HERE. This file is committed and is
# what anyone cloning the repository receives; `.env` is git-ignored. A
# connection string pasted into this line ships to everyone with repository
# access, and rotating it afterwards is the only remedy.
#
# If the password contains any of  : / ? # [ ] @  it must be percent-encoded,
# or the driver parses the string wrongly and reports a misleading host error.
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.at589pu.mongodb.net/admin?retryWrites=true&w=majority

# Which database inside the cluster holds AURIX's collections.
#
# Deliberately not `admin`, even though the URI above ends in `/admin`. That
# path component only selects the authentication database — writing application
# data into `admin` mixes it with the cluster's own user and role records.
MONGODB_DB=aurix

# ---- Tokens (required) ----------------------------------------------------
# Sign the JWTs this server issues. Use long random values — for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Changing either one signs every existing session out, which is the correct
# response to a suspected leak.
JWT_SECRET=
JWT_REFRESH_SECRET=

# How long an access token lives. Short by design: the refresh token is what
# keeps a user signed in, and a short access token limits the damage of one
# being captured.
ACCESS_TOKEN_TTL=30m

# How long a device stays signed in without re-entering a password.
REFRESH_TOKEN_DAYS=60

# Lifetime of a password-reset or email-verification link, in minutes.
ACTION_TOKEN_MINUTES=60

# ---- HTTP -----------------------------------------------------------------
PORT=4000
HOST=0.0.0.0

# Comma-separated origins allowed to call this API from a browser. Leave empty
# in development to reflect whatever origin asks; SET IT IN PRODUCTION.
# Native mobile builds are unaffected — CORS is a browser mechanism.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# ---- First administrator --------------------------------------------------
# The one account that is granted admin rights when it registers. Every
# administrator after that is promoted through the API by an existing one.
# Leave empty once the first admin exists.
BOOTSTRAP_ADMIN_EMAIL=

# ---- Uploads --------------------------------------------------------------
# Caps enforced before the bytes are read. A logo is a small raster image and a
# font is a few hundred KB; these are generous, not tight.
MAX_LOGO_BYTES=2097152
MAX_FONT_BYTES=4194304

# ---- Mail (optional) ------------------------------------------------------
# Without SMTP the server logs reset and verification tokens instead of mailing
# them, and — outside production only — returns them in the response so the
# flow is testable. A production deployment with no SMTP cannot deliver a
# password reset at all; it fails closed rather than leaking the token.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=AURIX <no-reply@aurix.app>

# Where reset and verification links point. Without it the email carries the
# raw code for the user to paste into the app instead.
# PUBLIC_APP_URL=https://app.example.com

# ---- DNS ------------------------------------------------------------------
# Only needed when the server fails at boot with `querySrv ECONNREFUSED`.
#
# `mongodb+srv://` is not an address — it is an instruction to look up a DNS
# SRV record. That lookup bypasses the OS resolver and talks to a DNS server
# directly on port 53, and some networks answer ordinary lookups while
# refusing SRV: corporate DNS, a VPN capturing port 53, an unusual router.
#
# Diagnose with:  npm run check-dns
#
# Setting this affects the SRV lookup only; everything else keeps using the
# machine's own configuration.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# ---- Logging --------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=debug
NODE_ENV=development

# ===========================================================================
# Phone sign-in
# ===========================================================================
# REQUIRES AN SMS PROVIDER. There is no console fallback and no "returned in
# development" escape hatch, because a one-time code is a complete sign-in
# credential for whatever number was typed into an unauthenticated endpoint —
# printing one to a console makes anybody who can read that console able to
# sign in as anyone whose number they can spell.
#
# So: with Twilio unconfigured, phone sign-in is switched OFF rather than
# degraded. `GET /api/v1/auth/methods` leaves it out, the app draws no Phone
# button, and `POST /auth/phone/start` refuses with `otp_unavailable` before a
# code is generated at all.
#
# The code is never in a response body, an error message, a log line or a
# health check, in any environment. See `server/src/services/sms.js`.

# Country code assumed for a number typed without one, e.g. +44.
#
# Empty means "insist on a country code", which is the safe default: there is
# no library here that knows national numbering plans, and guessing a region
# would mean texting somebody else's phone a code that signs in as them. Set it
# if your audience is in one country and you want them to type 07700 900123.
DEFAULT_PHONE_COUNTRY_CODE=

# The limits, which are what actually make a six-digit code safe. One in a
# million is a weak secret on its own; it is the short window, the small number
# of guesses and the cap on how often a fresh one can be summoned that make it
# a credential. Raising these weakens sign-in — they are not tuning knobs.
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_SENDS_PER_HOUR=5
OTP_RESEND_SECONDS=30

# Twilio. Reached over plain HTTPS rather than through their SDK — one POST
# with basic auth is not worth a dependency.
# Use TWILIO_MESSAGING_SERVICE_SID in preference to TWILIO_FROM where you have
# one: it handles sender selection and regional compliance for you.
#
# A Twilio trial account is free and enough to develop against; trial accounts
# can only text numbers you have verified, which is usually exactly what a
# developer needs.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550000000
# TWILIO_MESSAGING_SERVICE_SID=

# ---- Developing without an SMS account ------------------------------------
# `file` writes each code to a git-ignored file on the machine running the
# server instead of texting it, so the flow can be built and exercised with no
# provider at all.
#
# It is a local sink, NOT a fallback. It is forced off when NODE_ENV=production
# — in config/env.js, where the variable is read, so no route or request can
# opt back into it — and even switched on it puts nothing in a response, an
# error or the console: the log line names the file, never the code.
#
# Leave it empty for any deployment anyone else can reach.
# OTP_DEV_DELIVERY=file
# OTP_DEV_FILE=otp-dev.log

# ===========================================================================
# Signing in with Google, Apple, Facebook and GitHub
# ===========================================================================
# EVERY SECRET BELOW IS A SERVER SECRET AND MUST NEVER REACH THE APP.
#
# That is not a caution, it is the architecture. The app cannot do these flows
# itself, because doing them needs a client secret and a client secret compiled
# into an APK is a client secret published to everyone who installs it. So the
# app asks this server to start a flow, the browser goes to the provider, the
# provider comes back HERE, and this process does the code-for-token exchange.
# What crosses back to the app is a single-use AURIX grant — never a provider
# token, never a secret.
#
# Leave a provider's keys empty and it is simply not offered: `GET
# /api/v1/auth/methods` reports what is configured, and the login screen draws
# buttons only for those. A missing credential costs one button, not a crash.

# ---- Required for ALL FOUR providers --------------------------------------
# This server's public origin — the address the PROVIDER redirects a browser
# to. It must be reachable from the public internet (so `localhost` works only
# for a provider that permits it), it must be https in production, and the
# callback path below must be registered in each provider's console verbatim:
#
#     {PUBLIC_API_URL}/api/v1/auth/oauth/{google|apple|facebook|github}/callback
#
# Empty disables all four providers at once. Offering them without it would
# send users to a consent screen that redirects nowhere.
# PUBLIC_API_URL=https://api.example.com

# Where this server may hand the finished grant to. An exact-match allow-list,
# comma separated, and it is load bearing: the last hop of the flow puts a
# one-time credential in a URL, so without a list `?redirect_uri=` would make
# this server post that credential wherever it was asked to.
#
# Must match AURIX_LOGIN_REDIRECT_URI in the app's .env. Add the web build's
# https URL here too if you serve one.
OAUTH_APP_REDIRECTS=aurix://login-callback

# How long a browser transaction, and the grant it produces, stay valid.
OAUTH_STATE_MINUTES=10
OAUTH_GRANT_MINUTES=10

# ---- Google ---------------------------------------------------------------
# Cloud console -> APIs & Services -> Credentials -> OAuth client ID ->
# Web application. Add the callback URL above to "Authorised redirect URIs".
# Web application, not Android/iOS: the exchange happens on this server, so
# this is a confidential client even though the app is a mobile one.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Apple ----------------------------------------------------------------
# Apple has no client *secret*. It has a signing key, and the secret is a
# short-lived ES256 JWT this server mints from it on every exchange — which is
# why four values are needed instead of two.
#
#   APPLE_SERVICES_ID  the identifier of a **Services ID** (not the App ID),
#                      configured with "Sign in with Apple" enabled, your
#                      domain verified, and the callback URL above added to
#                      "Return URLs".
#   APPLE_TEAM_ID      Membership -> Team ID.
#   APPLE_KEY_ID       Keys -> the key you created with Sign in with Apple.
#   APPLE_PRIVATE_KEY  the whole body of the downloaded .p8, BEGIN/END lines
#                      included, with every newline written as a literal
#                      backslash-n so it survives being one variable. The
#                      server unescapes it at boot; a key whose newlines were
#                      lost fails at the first exchange with a signing error
#                      that names this variable.
#
# Note that Apple POSTs its callback rather than redirecting to it — that is
# what requesting the name and email scopes forces — and that the user's NAME
# arrives exactly once, on the very first authorization, and never again.
# APPLE_SERVICES_ID=com.example.aurix.web
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# ---- Facebook -------------------------------------------------------------
# developers.facebook.com -> your app -> Facebook Login -> Settings, with the
# callback URL above under "Valid OAuth Redirect URIs". Facebook only ever
# discloses a confirmed address, and omits it entirely for accounts registered
# against a phone number — such a sign-in creates its own AURIX account,
# because there is nothing to match an existing one on.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# ---- GitHub ---------------------------------------------------------------
# Settings -> Developer settings -> OAuth Apps. Put the callback URL above in
# "Authorization callback URL".
#
# Use an **OAuth App**, not a GitHub App: the code here does not send PKCE for
# GitHub, because OAuth Apps do not implement it and sending the parameters
# makes the exchange fail.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
